#!/usr/bin/env sh

echo "Checking staged files for English-only authored text..."
npm run check:english-text:staged || {
	echo "Staged content contains non-English authored text."
	exit 1
}

echo "🔐 Checking staged files for machine-local paths..."
npm run check:local-paths:staged || {
	echo "❌ Staged content contains a machine-local path."
	echo "   Replace it with \$WORKSPACE, \$PROJECT, \$HOME, or neutral fixture data."
	exit 1
}

echo "🔗 Validating the canonical CLI release policy..."
npm run check:cli-release-policy || {
	echo "❌ Workspai CLI version projections are out of sync."
	echo "   Update contracts/extension-cli-release-policy.v1.json, then run npm run sync:cli-release-policy."
	exit 1
}

# Shared contracts (canonical: workspai/packages/cli/contracts/)
echo "📋 Validating shared contracts..."
npm run validate:contracts || {
	echo "❌ Extension contracts are out of sync with Workspai CLI contracts."
	echo "   From workspai: npm run sync:shared-contracts"
	echo "   Then commit contracts/ in both repos."
	exit 1
}

echo "🔒 Validating package-lock integrity..."
npm run check:lockfile || {
	echo "❌ package-lock.json is incomplete for npm ci."
	echo "   Run npm install --package-lock-only and commit package-lock.json."
	exit 1
}

if [ "${SYNC_MODULES-}" = "1" ]; then
	npm run sync:modules
	git add src/data/modules.ts
fi
npx lint-staged
