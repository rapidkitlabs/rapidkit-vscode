# .gitignore for RapidKit VS Code Extension

# Compiled output
dist/
out/
*.vsix

# Node modules
node_modules/

# TypeScript
*.tsbuildinfo

# Test artifacts
.vscode-test/
test-results/

.vscode/settings.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo
*~

# Build artifacts
coverage/
.nyc_output/
.rapidkit

# Temporary files
tmp/
temp/

# Internal release governance fixtures (not for public repo)
releases/fixtures/

# Local/internal evidence outputs (not part of OSS source)
artifacts/

# Explicit local Workspai CLI development channel. This receipt may contain a
# machine-local checkout path and must never be committed or packaged.
.workspai-cli-local.json
